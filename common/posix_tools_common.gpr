with "../../hostkit/hostkit.gpr";
with "../../cryptolib/cryptolib.gpr";
with "../../i18n/i18n.gpr";
with "../../messages/messages.gpr";
with "../../terminal_styles/terminal_styles.gpr";

library project Posix_Tools_Common is
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "obj/common";
   for Library_Dir use "lib";
   for Library_Name use "posix_tools_common";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe");
      for Switches ("posix_tools-commands-tr.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
      for Switches ("posix_tools-commands-wc.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
      for Switches ("posix_tools-commands-nl.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
      for Switches ("posix_tools-commands-nl_numbering.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
      for Switches ("posix_tools-commands-file_helpers-tailing.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
      for Switches ("posix_tools-commands-od.adb") use
        ("-Og", "-g", "-gnat2022", "-gnata", "-gnatwa",
         "-gnaty3abcefhiklmnprtux", "-gnatyM120", "-gnatwe", "-O2");
   end Compiler;
end Posix_Tools_Common;
