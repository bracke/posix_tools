with "../../hostkit/hostkit.gpr";
with "../../messages/messages.gpr";
with "../../terminal_styles/terminal_styles.gpr";

library project Posix_Tools_Common is
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "obj/common";
   for Library_Dir use "lib";
   for Library_Name use "posix_tools_common";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnaty3abcefhiklmnoprstux", "-gnatyM120");
   end Compiler;
end Posix_Tools_Common;
