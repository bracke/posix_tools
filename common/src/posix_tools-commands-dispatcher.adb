package body Posix_Tools.Commands.Dispatcher is
   procedure Run
     (Command : Dispatch_Command;
      Context : in out Posix_Tools.Commands.Contexts.Context'Class;
      Result  : out Posix_Tools.Commands.Results.Result)
   is
   begin
      if Posix_Tools.Commands.Helpers.Intercept_Extension (Context, Result) then
         return;
      end if;

      case Command is
         when Arch_Command => Posix_Tools.Commands.Arch.Run (Context, Result);
         when Chgrp_Command => Posix_Tools.Commands.Chgrp.Run (Context, Result);
         when Chmod_Command => Posix_Tools.Commands.Chmod.Run (Context, Result);
         when Chown_Command => Posix_Tools.Commands.Chown.Run (Context, Result);
         when Cksum_Command => Posix_Tools.Commands.Cksum.Run (Context, Result);
         when Cmp_Command => Posix_Tools.Commands.Cmp.Run (Context, Result);
         when Comm_Command => Posix_Tools.Commands.Comm.Run (Context, Result);
         when Cp_Command => Posix_Tools.Commands.Cp.Run (Context, Result);
         when Cut_Command => Posix_Tools.Commands.Cut.Run (Context, Result);
         when Date_Command => Posix_Tools.Commands.Date.Run (Context, Result);
         when Dd_Command => Posix_Tools.Commands.Dd.Run (Context, Result);
         when Df_Command => Posix_Tools.Commands.Df.Run (Context, Result);
         when Du_Command => Posix_Tools.Commands.Du.Run (Context, Result);
         when Env_Command => Posix_Tools.Commands.Env.Run (Context, Result);
         when Expand_Command => Posix_Tools.Commands.Expand.Run (Context, Result);
         when Expr_Command => Posix_Tools.Commands.Expr.Run (Context, Result);
         when File_Command => Posix_Tools.Commands.File.Run (Context, Result);
         when Find_Command => Posix_Tools.Commands.Find.Run (Context, Result);
         when Fold_Command => Posix_Tools.Commands.Fold.Run (Context, Result);
         when Getconf_Command => Posix_Tools.Commands.Getconf.Run (Context, Result);
         when Groups_Command => Posix_Tools.Commands.Groups.Run (Context, Result);
         when Hostname_Command => Posix_Tools.Commands.Hostname.Run (Context, Result);
         when Id_Command => Posix_Tools.Commands.Id.Run (Context, Result);
         when Kill_Command => Posix_Tools.Commands.Kill.Run (Context, Result);
         when Link_Command => Posix_Tools.Commands.Link.Run (Context, Result);
         when Ln_Command => Posix_Tools.Commands.Ln.Run (Context, Result);
         when Locale_Command => Posix_Tools.Commands.Locale.Run (Context, Result);
         when Logname_Command => Posix_Tools.Commands.Logname.Run (Context, Result);
         when Ls_Command => Posix_Tools.Commands.Ls.Run (Context, Result);
         when Mkdir_Command => Posix_Tools.Commands.Mkdir.Run (Context, Result);
         when Mkfifo_Command => Posix_Tools.Commands.Mkfifo.Run (Context, Result);
         when Mv_Command => Posix_Tools.Commands.Mv.Run (Context, Result);
         when Nice_Command => Posix_Tools.Commands.Nice.Run (Context, Result);
         when Nl_Command => Posix_Tools.Commands.Nl.Run (Context, Result);
         when Nohup_Command => Posix_Tools.Commands.Nohup.Run (Context, Result);
         when Od_Command => Posix_Tools.Commands.Od.Run (Context, Result);
         when Paste_Command => Posix_Tools.Commands.Paste.Run (Context, Result);
         when Pathchk_Command => Posix_Tools.Commands.Pathchk.Run (Context, Result);
         when Printenv_Command => Posix_Tools.Commands.Printenv.Run (Context, Result);
         when Printf_Command => Posix_Tools.Commands.Printf.Run (Context, Result);
         when Readlink_Command => Posix_Tools.Commands.Readlink.Run (Context, Result);
         when Realpath_Command => Posix_Tools.Commands.Realpath.Run (Context, Result);
         when Rm_Command => Posix_Tools.Commands.Rm.Run (Context, Result);
