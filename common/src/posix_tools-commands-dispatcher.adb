         when Xargs_Command => Posix_Tools.Commands.Xargs.Run (Context, Result);
         when Yes_Command => Posix_Tools.Commands.Yes.Run (Context, Result);
      end case;
   end Run;
end Posix_Tools.Commands.Dispatcher;
