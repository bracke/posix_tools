         when Seq_Command => Posix_Tools.Commands.Seq.Run (Context, Result);
         when Sha256sum_Command => Posix_Tools.Commands.Sha256sum.Run (Context, Result);
         when Sleep_Command => Posix_Tools.Commands.Sleep.Run (Context, Result);
         when Split_Command => Posix_Tools.Commands.Split.Run (Context, Result);
         when Sort_Command => Posix_Tools.Commands.Sort.Run (Context, Result);
         when Stat_Command => Posix_Tools.Commands.Stat.Run (Context, Result);
         when Tee_Command => Posix_Tools.Commands.Tee.Run (Context, Result);
         when Test_Command => Posix_Tools.Commands.Test_Command.Run (Context, Result);
         when Timeout_Command => Posix_Tools.Commands.Timeout.Run (Context, Result);
         when Touch_Command => Posix_Tools.Commands.Touch.Run (Context, Result);
         when Tr_Command => Posix_Tools.Commands.Tr.Run (Context, Result);
         when Tty_Command => Posix_Tools.Commands.Tty.Run (Context, Result);
         when Unexpand_Command => Posix_Tools.Commands.Unexpand.Run (Context, Result);
         when Unlink_Command => Posix_Tools.Commands.Unlink.Run (Context, Result);
         when Uname_Command => Posix_Tools.Commands.Uname.Run (Context, Result);
