with "../common/posix_tools_common.gpr";
with "aunit.gpr";
with "../../project_tools/project_tools.gpr";

project Posix_Tools_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Main use ("posix_tools_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnaty3abcefhiklmnoprstux", "-gnatyM120");
   end Compiler;
end Posix_Tools_Tests;
