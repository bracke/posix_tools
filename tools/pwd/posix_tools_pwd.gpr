with "../../common/posix_tools_common.gpr";

project Posix_Tools_Pwd is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/pwd";
   for Exec_Dir use "bin";
   for Main use ("pwd.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-gnatyM120");
   end Compiler;
end Posix_Tools_Pwd;
