with "../../common/posix_tools_common.gpr";
with "../../../greplib/greplib.gpr";
with "../../../regexp/regexp.gpr";
with "../../../messages/messages.gpr";
with "../../../terminal_styles/terminal_styles.gpr";

project Posix_Tools_Grep is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/grep";
   for Exec_Dir use "bin";
   for Main use ("grep.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Posix_Tools_Grep;
