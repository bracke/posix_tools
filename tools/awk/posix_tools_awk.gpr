with "../../common/posix_tools_common.gpr";
with "../../../awklib/awklib.gpr";
with "../../../hostkit/hostkit.gpr";
with "../../../messages/messages.gpr";
with "../../../terminal_styles/terminal_styles.gpr";

project Posix_Tools_Awk is
   for Source_Dirs use ("src", "src/library");
   for Object_Dir use "obj/awk";
   for Exec_Dir use "bin";
   for Main use ("awk.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Artifacts ("share/awk") use ("resources/messages");
   end Install;
end Posix_Tools_Awk;
