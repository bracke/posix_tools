   function Resolve_Label
     (Label : String; Mode : out Encoding_Mode) return Boolean
   is
      First : Integer := Label'First;
      Last  : Integer := Label'Last;
      Lower : String := Label;
      function Is_UTF_8 (Value : String) return Boolean is
        (Value in
           "unicode-1-1-utf-8"
         | "unicode11utf8"
         | "unicode20utf8"
         | "utf-8"
         | "utf8"
         | "x-unicode20utf8");

      function Is_IBM866 (Value : String) return Boolean is
        (Value in
           "866"
         | "cp866"
         | "csibm866"
         | "ibm866");

      function Is_ISO_8859_2 (Value : String) return Boolean is
        (Value in
           "csisolatin2"
         | "iso-8859-2"
         | "iso-ir-101"
         | "iso8859-2"
         | "iso88592"
         | "iso_8859-2"
         | "iso_8859-2:1987"
         | "l2"
         | "latin2");

      function Is_ISO_8859_3 (Value : String) return Boolean is
        (Value in
           "csisolatin3"
         | "iso-8859-3"
         | "iso-ir-109"
         | "iso8859-3"
         | "iso88593"
         | "iso_8859-3"
         | "iso_8859-3:1988"
         | "l3"
         | "latin3");

      function Is_ISO_8859_4 (Value : String) return Boolean is
        (Value in
           "csisolatin4"
         | "iso-8859-4"
         | "iso-ir-110"
         | "iso8859-4"
         | "iso88594"
         | "iso_8859-4"
         | "iso_8859-4:1988"
         | "l4"
         | "latin4");

      function Is_ISO_8859_5 (Value : String) return Boolean is
        (Value in
           "csisolatincyrillic"
         | "cyrillic"
         | "iso-8859-5"
         | "iso-ir-144"
         | "iso8859-5"
         | "iso88595"
         | "iso_8859-5"
         | "iso_8859-5:1988");

      function Is_ISO_8859_6 (Value : String) return Boolean is
        (Value in
           "arabic"
         | "asmo-708"
         | "csiso88596e"
         | "csiso88596i"
         | "csisolatinarabic"
         | "ecma-114"
         | "iso-8859-6"
         | "iso-8859-6-e"
         | "iso-8859-6-i"
         | "iso-ir-127"
         | "iso8859-6"
         | "iso88596"
         | "iso_8859-6"
         | "iso_8859-6:1987");

      function Is_ISO_8859_7 (Value : String) return Boolean is
        (Value in
           "csisolatingreek"
         | "ecma-118"
         | "elot_928"
         | "greek"
         | "greek8"
         | "iso-8859-7"
         | "iso-ir-126"
         | "iso8859-7"
         | "iso88597"
         | "iso_8859-7"
         | "iso_8859-7:1987"
         | "sun_eu_greek");

      function Is_ISO_8859_8 (Value : String) return Boolean is
        (Value in
           "csiso88598e"
         | "csisolatinhebrew"
         | "hebrew"
         | "iso-8859-8"
         | "iso-8859-8-e"
         | "iso-ir-138"
         | "iso8859-8"
         | "iso88598"
         | "iso_8859-8"
         | "iso_8859-8:1988"
         | "visual"
         | "csiso88598i"
         | "iso-8859-8-i"
         | "logical");

      function Is_ISO_8859_10 (Value : String) return Boolean is
        (Value in
           "csisolatin6"
         | "iso-8859-10"
         | "iso-ir-157"
         | "iso8859-10"
         | "iso885910"
         | "l6"
         | "latin6");

      function Is_ISO_8859_13 (Value : String) return Boolean is
        (Value in
           "iso-8859-13"
         | "iso8859-13"
         | "iso885913");

      function Is_ISO_8859_14 (Value : String) return Boolean is
        (Value in
           "iso-8859-14"
         | "iso8859-14"
         | "iso885914");

      function Is_ISO_8859_15 (Value : String) return Boolean is
        (Value in
           "csisolatin9"
         | "iso-8859-15"
         | "iso8859-15"
         | "iso885915"
         | "iso_8859-15"
         | "l9");

      function Is_ISO_8859_16 (Value : String) return Boolean is
        (Value in
           "iso-8859-16");

      function Is_KOI8_R (Value : String) return Boolean is
        (Value in
           "cskoi8r"
         | "koi"
         | "koi8"
         | "koi8-r"
         | "koi8_r");

      function Is_KOI8_U (Value : String) return Boolean is
        (Value in
           "koi8-ru"
         | "koi8-u");

      function Is_Macintosh (Value : String) return Boolean is
        (Value in
           "csmacintosh"
         | "mac"
         | "macintosh"
         | "x-mac-roman");

      function Is_Windows_874 (Value : String) return Boolean is
        (Value in
           "dos-874"
         | "iso-8859-11"
         | "iso8859-11"
         | "iso885911"
         | "tis-620"
         | "windows-874");

      function Is_Windows_1250 (Value : String) return Boolean is
        (Value in
           "cp1250"
         | "windows-1250"
         | "x-cp1250");

      function Is_Windows_1251 (Value : String) return Boolean is
        (Value in
           "cp1251"
         | "windows-1251"
         | "x-cp1251");

      function Is_Windows_1252 (Value : String) return Boolean is
        (Value in
           "ansi_x3.4-1968"
         | "ascii"
         | "cp1252"
         | "cp819"
         | "csisolatin1"
         | "ibm819"
         | "iso-8859-1"
         | "iso-ir-100"
         | "iso8859-1"
         | "iso88591"
         | "iso_8859-1"
         | "iso_8859-1:1987"
         | "l1"
         | "latin1"
         | "us-ascii"
         | "windows-1252"
         | "x-cp1252");

      function Is_Windows_1253 (Value : String) return Boolean is
        (Value in
           "cp1253"
         | "windows-1253"
         | "x-cp1253");

      function Is_Windows_1254 (Value : String) return Boolean is
        (Value in
           "cp1254"
         | "csisolatin5"
         | "iso-8859-9"
         | "iso-ir-148"
         | "iso8859-9"
         | "iso88599"
         | "iso_8859-9"
         | "iso_8859-9:1989"
         | "l5"
         | "latin5"
         | "windows-1254"
         | "x-cp1254");

      function Is_Windows_1255 (Value : String) return Boolean is
        (Value in
           "cp1255"
         | "windows-1255"
         | "x-cp1255");

      function Is_Windows_1256 (Value : String) return Boolean is
        (Value in
           "cp1256"
         | "windows-1256"
         | "x-cp1256");

      function Is_Windows_1257 (Value : String) return Boolean is
        (Value in
           "cp1257"
         | "windows-1257"
         | "x-cp1257");

      function Is_Windows_1258 (Value : String) return Boolean is
        (Value in
           "cp1258"
         | "windows-1258"
         | "x-cp1258");

      function Is_X_Mac_Cyrillic (Value : String) return Boolean is
        (Value in
           "x-mac-cyrillic"
         | "x-mac-ukrainian");

      function Is_GBK (Value : String) return Boolean is
        (Value in
           "chinese"
         | "csgb2312"
         | "csiso58gb231280"
         | "gb2312"
         | "gb_2312"
         | "gb_2312-80"
         | "gbk"
         | "iso-ir-58"
         | "x-gbk");

      function Is_GB18030 (Value : String) return Boolean is
        (Value in
           "gb18030");

      function Is_Big5 (Value : String) return Boolean is
        (Value in
           "big5"
         | "big5-hkscs"
         | "cn-big5"
         | "csbig5"
         | "x-x-big5");

      function Is_EUC_JP (Value : String) return Boolean is
        (Value in
           "cseucpkdfmtjapanese"
         | "euc-jp"
         | "x-euc-jp");

      function Is_ISO_2022_JP (Value : String) return Boolean is
        (Value in
           "csiso2022jp"
         | "iso-2022-jp");

      function Is_Shift_JIS (Value : String) return Boolean is
        (Value in
           "csshiftjis"
         | "ms932"
         | "ms_kanji"
         | "shift-jis"
         | "shift_jis"
         | "sjis"
         | "windows-31j"
         | "x-sjis");

      function Is_EUC_KR (Value : String) return Boolean is
        (Value in
           "cseuckr"
         | "csksc56011987"
         | "euc-kr"
         | "iso-ir-149"
         | "korean"
         | "ks_c_5601-1987"
         | "ks_c_5601-1989"
         | "ksc5601"
         | "ksc_5601"
         | "windows-949");

      function Is_Replacement (Value : String) return Boolean is
        (Value in
           "csiso2022kr"
         | "hz-gb-2312"
         | "iso-2022-cn"
         | "iso-2022-cn-ext"
         | "iso-2022-kr"
         | "replacement");

      function Is_UTF_16BE (Value : String) return Boolean is
        (Value in
           "unicodefffe"
         | "utf-16be");

      function Is_UTF_16LE (Value : String) return Boolean is
        (Value in
           "csunicode"
         | "iso-10646-ucs-2"
         | "ucs-2"
         | "unicode"
         | "unicodefeff"
         | "utf-16"
         | "utf-16le");

      function Is_X_User_Defined (Value : String) return Boolean is
        (Value in
           "x-user-defined");

   begin
      while First <= Last and then Label (First) in ASCII.HT | ASCII.LF | ASCII.FF | ASCII.CR | ' ' loop
         First := First + 1;
      end loop;
      while Last >= First and then Label (Last) in ASCII.HT | ASCII.LF | ASCII.FF | ASCII.CR | ' ' loop
         Last := Last - 1;
      end loop;
      for Item of Lower loop
         if Item in 'A' .. 'Z' then
            Item := Character'Val (Character'Pos (Item) + 32);
         end if;
      end loop;
      if First > Last then
         return False;
      end if;

      declare
         Value : constant String := Lower (First .. Last);
      begin
         if Value = "auto" then
            Mode := Automatic_Encoding;
         elsif Value = "none" then
            Mode := No_Encoding;
         elsif Is_UTF_8 (Value) then
            Mode := UTF_8_Encoding;
         elsif Is_IBM866 (Value) then
            Mode := IBM866_Encoding;
         elsif Is_ISO_8859_2 (Value) then
            Mode := ISO_8859_2_Encoding;
         elsif Is_ISO_8859_3 (Value) then
            Mode := ISO_8859_3_Encoding;
         elsif Is_ISO_8859_4 (Value) then
            Mode := ISO_8859_4_Encoding;
         elsif Is_ISO_8859_5 (Value) then
            Mode := ISO_8859_5_Encoding;
         elsif Is_ISO_8859_6 (Value) then
            Mode := ISO_8859_6_Encoding;
         elsif Is_ISO_8859_7 (Value) then
            Mode := ISO_8859_7_Encoding;
         elsif Is_ISO_8859_8 (Value) then
            Mode := ISO_8859_8_Encoding;
         elsif Is_ISO_8859_10 (Value) then
            Mode := ISO_8859_10_Encoding;
         elsif Is_ISO_8859_13 (Value) then
            Mode := ISO_8859_13_Encoding;
         elsif Is_ISO_8859_14 (Value) then
            Mode := ISO_8859_14_Encoding;
         elsif Is_ISO_8859_15 (Value) then
            Mode := ISO_8859_15_Encoding;
         elsif Is_ISO_8859_16 (Value) then
            Mode := ISO_8859_16_Encoding;
         elsif Is_KOI8_R (Value) then
            Mode := KOI8_R_Encoding;
         elsif Is_KOI8_U (Value) then
            Mode := KOI8_U_Encoding;
         elsif Is_Macintosh (Value) then
            Mode := Macintosh_Encoding;
         elsif Is_Windows_874 (Value) then
            Mode := Windows_874_Encoding;
         elsif Is_Windows_1250 (Value) then
            Mode := Windows_1250_Encoding;
         elsif Is_Windows_1251 (Value) then
            Mode := Windows_1251_Encoding;
         elsif Is_Windows_1252 (Value) then
            Mode := Windows_1252_Encoding;
         elsif Is_Windows_1253 (Value) then
            Mode := Windows_1253_Encoding;
         elsif Is_Windows_1254 (Value) then
            Mode := Windows_1254_Encoding;
         elsif Is_Windows_1255 (Value) then
            Mode := Windows_1255_Encoding;
         elsif Is_Windows_1256 (Value) then
            Mode := Windows_1256_Encoding;
         elsif Is_Windows_1257 (Value) then
            Mode := Windows_1257_Encoding;
         elsif Is_Windows_1258 (Value) then
            Mode := Windows_1258_Encoding;
         elsif Is_X_Mac_Cyrillic (Value) then
            Mode := X_Mac_Cyrillic_Encoding;
         elsif Is_GBK (Value) then
            Mode := GBK_Encoding;
         elsif Is_GB18030 (Value) then
            Mode := GB18030_Encoding;
         elsif Is_Big5 (Value) then
            Mode := Big5_Encoding;
         elsif Is_EUC_JP (Value) then
            Mode := EUC_JP_Encoding;
         elsif Is_ISO_2022_JP (Value) then
            Mode := ISO_2022_JP_Encoding;
         elsif Is_Shift_JIS (Value) then
            Mode := Shift_JIS_Encoding;
         elsif Is_EUC_KR (Value) then
            Mode := EUC_KR_Encoding;
         elsif Is_Replacement (Value) then
            Mode := Replacement_Encoding;
         elsif Is_UTF_16BE (Value) then
            Mode := UTF_16BE_Encoding;
         elsif Is_UTF_16LE (Value) then
            Mode := UTF_16LE_Encoding;
         elsif Is_X_User_Defined (Value) then
            Mode := X_User_Defined_Encoding;
         else
            return False;
         end if;
      end;
      return True;
   end Resolve_Label;

   function Decode_Single_Byte
     (Kind : Single_Byte_Kind; Value : Ada.Streams.Stream_Element) return Code_Point
   is
   begin
      if Value < 16#80# then
         return Code_Point (Value);
      end if;
      declare
         Index : constant Natural := Natural (Value) - 16#80#;
      begin
         case Kind is
            when IBM866_Kind => return IBM866_Table (Index);
            when ISO_8859_2_Kind => return ISO_8859_2_Table (Index);
            when ISO_8859_3_Kind => return ISO_8859_3_Table (Index);
            when ISO_8859_4_Kind => return ISO_8859_4_Table (Index);
            when ISO_8859_5_Kind => return ISO_8859_5_Table (Index);
            when ISO_8859_6_Kind => return ISO_8859_6_Table (Index);
            when ISO_8859_7_Kind => return ISO_8859_7_Table (Index);
            when ISO_8859_8_Kind => return ISO_8859_8_Table (Index);
            when ISO_8859_10_Kind => return ISO_8859_10_Table (Index);
            when ISO_8859_13_Kind => return ISO_8859_13_Table (Index);
            when ISO_8859_14_Kind => return ISO_8859_14_Table (Index);
            when ISO_8859_15_Kind => return ISO_8859_15_Table (Index);
            when ISO_8859_16_Kind => return ISO_8859_16_Table (Index);
            when KOI8_R_Kind => return KOI8_R_Table (Index);
            when KOI8_U_Kind => return KOI8_U_Table (Index);
            when Macintosh_Kind => return Macintosh_Table (Index);
            when Windows_874_Kind => return Windows_874_Table (Index);
            when Windows_1250_Kind => return Windows_1250_Table (Index);
            when Windows_1251_Kind => return Windows_1251_Table (Index);
            when Windows_1252_Kind => return Windows_1252_Table (Index);
            when Windows_1253_Kind => return Windows_1253_Table (Index);
            when Windows_1254_Kind => return Windows_1254_Table (Index);
            when Windows_1255_Kind => return Windows_1255_Table (Index);
            when Windows_1256_Kind => return Windows_1256_Table (Index);
            when Windows_1257_Kind => return Windows_1257_Table (Index);
            when Windows_1258_Kind => return Windows_1258_Table (Index);
            when X_Mac_Cyrillic_Kind => return X_Mac_Cyrillic_Table (Index);
         end case;
      end;
   end Decode_Single_Byte;

   function Decode_Big5 (Pointer : Natural) return Code_Point is
     (if Pointer in Big5_Table'Range then Big5_Table (Pointer) else Invalid_Code_Point);

   function Decode_EUC_KR (Pointer : Natural) return Code_Point is
     (if Pointer in EUC_KR_Table'Range then EUC_KR_Table (Pointer) else Invalid_Code_Point);

   function Decode_GB18030_Two_Byte (Pointer : Natural) return Code_Point is
     (if Pointer in GB18030_Table'Range then GB18030_Table (Pointer) else Invalid_Code_Point);

   function Decode_JIS0208 (Pointer : Natural) return Code_Point is
     (if Pointer in JIS0208_Table'Range then JIS0208_Table (Pointer) else Invalid_Code_Point);

   function Decode_JIS0212 (Pointer : Natural) return Code_Point is
     (if Pointer in JIS0212_Table'Range then JIS0212_Table (Pointer) else Invalid_Code_Point);

   function Decode_GB18030_Range (Pointer : Natural) return Code_Point is
      Low  : Natural := GB18030_Range_Pointers'First;
      High : Natural := GB18030_Range_Pointers'Last;
   begin
      if Pointer > 1_237_575 then
         return Invalid_Code_Point;
      elsif Pointer >= 189_000 then
         return Code_Point (Pointer - 189_000 + 16#10000#);
      elsif Pointer > 39_419 then
         return Invalid_Code_Point;
      end if;
      while Low < High loop
         declare
            Middle : constant Natural := (Low + High + 1) / 2;
         begin
            if Natural (GB18030_Range_Pointers (Middle)) <= Pointer then
               Low := Middle;
            else
               High := Middle - 1;
            end if;
         end;
      end loop;
      return GB18030_Range_Code_Points (Low)
        + Code_Point (Pointer - Natural (GB18030_Range_Pointers (Low)));
   end Decode_GB18030_Range;

end Posix_Tools.Commands.Rg.Encodings;
