with "../../common/posix_tools_common.gpr";

project Posix_Tools_False is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/false";
   for Exec_Dir use "bin";
   for Main use ("false.adb");
   package Naming is
      for Body ("Posix_Tools_False_Main") use "false.adb";
   end Naming;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-gnatyM120");
   end Compiler;
end Posix_Tools_False;
