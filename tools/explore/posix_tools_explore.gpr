with "../../common/posix_tools_common.gpr";
with "../../../greplib/greplib.gpr";

project Posix_Tools_Explore is
   for Source_Dirs use ("src", "src/library");
   for Object_Dir use "obj/explore";
   for Exec_Dir use "bin";
   for Main use ("explore_main.adb");

   package Builder is
      for Executable ("explore_main.adb") use "explore";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnaty3abcefhiklmnoprstux", "-gnatyM120");
   end Compiler;
end Posix_Tools_Explore;
