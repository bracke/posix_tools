with "../../../common/posix_tools_common.gpr";
with "aunit.gpr";
with "../../../../greplib/greplib.gpr";
with "../../../../tarlib/tarlib.gpr";
with "../../../../zlib/zlib.gpr";
with "../../../../tomllib/tomllib.gpr";

--  The explore library's sources are compiled straight into the test program:
--  explore is an executable crate, and a test crate may not depend on it.
project Posix_Tools_Explore_Tests is
   for Source_Dirs use ("src", "../src/library");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Main use ("explore_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnaty3abcefhiklmnoprstux", "-gnatyM120");
   end Compiler;
end Posix_Tools_Explore_Tests;
