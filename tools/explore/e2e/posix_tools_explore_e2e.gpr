with "aunit.gpr";
with "../../../../terminal/terminal_common/terminal_common.gpr";
with "../../../../terminal/terminal_core/terminal_core.gpr";
with "../../../../terminal/terminal_pty/terminal_pty.gpr";

--  explore run as a user runs it: in a pseudo-terminal, with bracke-terminal's
--  own emulator core on the other side answering its queries and keeping the
--  screen it draws. The explore binary is the one built in ../bin.
project Posix_Tools_Explore_E2E is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/e2e";
   for Exec_Dir use "bin";
   for Main use ("explore_e2e.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnaty3abcefhiklmnoprstux", "-gnatyM120");
   end Compiler;
end Posix_Tools_Explore_E2E;
